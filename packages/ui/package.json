{
  "name": "@app/ui",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts",
      "require": "./src/theme/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'UI package uses source files directly'",
    "dev": "echo 'UI package uses source files directly'",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit || true",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@app/copy": "workspace:*",
    "@tamagui/animations-react-native": "^1.118.0",
    "@tamagui/config": "^1.118.0",
    "@tamagui/core": "^1.118.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-svg": "^15.8.0",
    "tamagui": "^1.118.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jsdom": "^24.0.0",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.19.12",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.70.0"
  }
}
