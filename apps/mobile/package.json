{
  "name": "@app/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:ios": "expo run:ios",
    "dev:android": "expo run:android",
    "build": "expo export",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --profile preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist node_modules/.cache"
  },
  "dependencies": {
    "@app/data": "workspace:*",
    "@app/domain": "workspace:*",
    "@app/ui": "workspace:*",
    "@app/copy": "workspace:*",
    "@tamagui/config": "^1.118.0",
    "@tamagui/core": "^1.118.0",
    "@tamagui/font-inter": "^1.118.0",
    "@tamagui/animations-react-native": "^1.118.0",
    "@tamagui/shorthands": "^1.118.0",
    "@tamagui/lucide-icons": "^1.118.0",
    "@tanstack/react-query": "^5.60.0",
    "expo": "~52.0.0",
    "expo-background-fetch": "~13.0.0",
    "expo-camera": "~16.0.0",
    "expo-haptics": "~14.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-health": "^1.18.0",
    "react-native-health-connect": "^3.1.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "~15.8.0",
    "tamagui": "^1.118.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@tamagui/babel-plugin": "^1.118.0",
    "@testing-library/react-native": "^12.8.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5.4.0"
  }
}
