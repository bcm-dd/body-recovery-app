# ===========================================
# Body Recovery Companion - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Body Recovery Companion"

# Vercel (auto-populated in Vercel deployments)
VERCEL_ENV=development
VERCEL_URL=localhost:3000
VERCEL_GIT_COMMIT_SHA=local

# Authentication (for future use)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here

# Database (for future use with Vercel Postgres)
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# KV Store (for future use with Vercel KV)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Blob Storage (for future use with Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# AI Integration (for future use)
# ANTHROPIC_API_KEY=

# Cron Jobs
CRON_SECRET=your-cron-secret-here

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Error Tracking (optional)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
