# =============================================================================
# Body Recovery Companion - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values
#
# SECURITY NOTES:
# - NEVER commit .env.local to version control
# - All NEXT_PUBLIC_* vars are exposed to the client - NO secrets here
# - Server-only vars (no NEXT_PUBLIC_ prefix) are safe for secrets
# - Use strong, unique values for all secrets (32+ chars recommended)
# - Use: openssl rand -base64 32 to generate secure secrets
# =============================================================================

# === Application Configuration (Public) ===

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Body Recovery Companion"

# Environment: development | staging | production | test
NEXT_PUBLIC_APP_ENV=development

# === Feature Flags (Public) ===

# Enable Progressive Web App features
NEXT_PUBLIC_ENABLE_PWA=true

# Enable analytics tracking (requires user consent)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# === Vercel (auto-populated in Vercel deployments) ===

VERCEL_ENV=development
VERCEL_URL=localhost:3000
VERCEL_GIT_COMMIT_SHA=local

# === Authentication (Server Only - SENSITIVE) ===

# Auth.js / NextAuth configuration
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# JWT secret for token signing (min 32 chars)
# AUTH_SECRET=generate-with-openssl-rand-base64-32

# === Database (Server Only - SENSITIVE) ===

# Vercel Postgres
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Or generic database URL
# DATABASE_URL=postgresql://user:password@host:5432/db

# === Key-Value Store (Server Only - SENSITIVE) ===

# Vercel KV (for rate limiting, sessions)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# Or Upstash Redis
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# === Blob Storage (Server Only - SENSITIVE) ===

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# === AI Integration (Server Only - SENSITIVE) ===

# OpenAI (for AI features)
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# === Email Service (Server Only - SENSITIVE) ===

# Resend
# RESEND_API_KEY=re_...

# === Scheduled Tasks (Server Only - SENSITIVE) ===

# Secret for authenticating cron job requests (min 16 chars)
# Generate with: openssl rand -hex 16
CRON_SECRET=your-cron-secret-here-replace-in-production

# === Analytics (Public - IDs only) ===

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics
# NEXT_PUBLIC_ANALYTICS_ID=G-...

# === Error Tracking & Monitoring (SENSITIVE) ===

# Sentry
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=

# === API Security (Server Only - SENSITIVE) ===

# API secret key for internal authentication
# API_SECRET_KEY=generate-with-openssl-rand-hex-32

# === Rate Limiting ===

# Requests per minute for API endpoints
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Local Development Overrides
# =============================================================================

# Enable development debugging
# DEBUG=true

# Skip environment validation (development only!)
# SKIP_ENV_VALIDATION=true

# =============================================================================
# Security Checklist Before Deployment:
# =============================================================================
# [ ] All secrets are unique and randomly generated
# [ ] No .env.local or secrets in git history
# [ ] CRON_SECRET is at least 16 characters
# [ ] AUTH_SECRET is at least 32 characters
# [ ] Database credentials use least-privilege access
# [ ] API keys are scoped appropriately
# =============================================================================
