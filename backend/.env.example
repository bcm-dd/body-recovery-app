# Backend Environment Variables
# Copy to .env.local for local development

# Database (auto-populated when you connect Vercel Postgres)
POSTGRES_URL="postgres://..."

# Vercel AI Gateway
# Get this from: Vercel Dashboard → Project → Settings → Environment Variables
# The gateway secret is auto-generated when you enable AI Gateway
VERCEL_AI_GATEWAY_SECRET="vag_..."

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_SECRET="your-secure-jwt-secret-min-32-chars"

# NextAuth.js (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
