{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/setup-dev-team-framework-mt9bO": true
    }
  },
  "buildCommand": "cd backend && npm run build",
  "outputDirectory": "backend/.next",
  "installCommand": "npm install && npm run web:build && cd backend && npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-readiness",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 9 * * 0"
    }
  ]
}
