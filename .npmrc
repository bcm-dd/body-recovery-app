# =============================================================================
# NPM Configuration - Security Settings
# =============================================================================

# Package manager
engine-strict=true

# Security settings
audit=true
audit-level=moderate

# Registry settings (use default npm registry)
registry=https://registry.npmjs.org/

# Strict peer dependencies (helps prevent supply chain attacks)
strict-peer-dependencies=true

# Package lock settings
package-lock=true

# Prevent scripts from running during install (security measure)
# Uncomment if you want stricter security (may break some packages)
# ignore-scripts=true

# Prevent package.json from being modified on install
save-exact=false
save-prefix=^

# Logging
loglevel=warn

# Network settings for reliability
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Cache settings
cache-min=10

# =============================================================================
# Security Policy
# =============================================================================
#
# Dependency Update Policy:
# 1. Run `pnpm audit` weekly or before each release
# 2. Critical vulnerabilities: Fix within 24 hours
# 3. High vulnerabilities: Fix within 1 week
# 4. Moderate vulnerabilities: Fix within 1 month
# 5. Low vulnerabilities: Fix in next release cycle
#
# Before adding new dependencies:
# 1. Check npm audit report for the package
# 2. Review package download counts and maintenance activity
# 3. Check for known vulnerabilities on snyk.io
# 4. Prefer packages with TypeScript support
# 5. Prefer packages with active maintenance (commits in last 6 months)
#
# =============================================================================
